{
  "version": 8,
  "name": "ne-110m",
  "metadata": {
    "coastlines:chart": "ne-110m",
    "coastlines:source": "Natural Earth v5.1.2, public domain"
  },
  "sources": {
    "coastlines": {
      "type": "vector",
      "tiles": [
        "/plugins/coastlines/charts/ne-110m/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 4
    }
  },
  "layers": [
    {
      "id": "ocean",
      "type": "fill",
      "source": "coastlines",
      "source-layer": "ocean",
      "minzoom": 0,
      "paint": {
        "fill-color": "#d4e6f3"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "coastlines",
      "source-layer": "land",
      "minzoom": 0,
      "paint": {
        "fill-color": "#f4f0e6"
      }
    },
    {
      "id": "glaciated_areas",
      "type": "fill",
      "source": "coastlines",
      "source-layer": "glaciated_areas",
      "minzoom": 2,
      "paint": {
        "fill-color": "#ffffff",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "lakes",
      "type": "fill",
      "source": "coastlines",
      "source-layer": "lakes",
      "minzoom": 2,
      "paint": {
        "fill-color": "#cfe2f0"
      }
    },
    {
      "id": "rivers_lake_centerlines",
      "type": "line",
      "source": "coastlines",
      "source-layer": "rivers_lake_centerlines",
      "minzoom": 3,
      "paint": {
        "line-color": "#9bbfd8",
        "line-width": 0.8
      }
    },
    {
      "id": "admin_0_countries",
      "type": "line",
      "source": "coastlines",
      "source-layer": "admin_0_countries",
      "minzoom": 2,
      "paint": {
        "line-color": "#b89a8a",
        "line-width": 0.3,
        "line-opacity": 0.5
      }
    },
    {
      "id": "admin_0_boundary_lines_land",
      "type": "line",
      "source": "coastlines",
      "source-layer": "admin_0_boundary_lines_land",
      "minzoom": 1,
      "paint": {
        "line-color": "#b89a8a",
        "line-width": 1,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "coastlines",
      "source-layer": "coastline",
      "minzoom": 0,
      "paint": {
        "line-color": "#5f7f9b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.6,
          7,
          1.4,
          12,
          2
        ]
      }
    },
    {
      "id": "geographic_lines",
      "type": "line",
      "source": "coastlines",
      "source-layer": "geographic_lines",
      "minzoom": 0,
      "paint": {
        "line-color": "#9fb3c1",
        "line-width": 0.8,
        "line-dasharray": [
          6,
          4
        ]
      }
    },
    {
      "id": "populated_places",
      "type": "circle",
      "source": "coastlines",
      "source-layer": "populated_places",
      "minzoom": 2,
      "paint": {
        "circle-color": "#5d6b78",
        "circle-radius": 2,
        "circle-opacity": 0.8
      }
    }
  ]
}
