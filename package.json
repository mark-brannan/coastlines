{
  "name": "coastlines",
  "version": "0.0.3-alpha.0",
  "description": "Natural Earth geography on a boat, installed rather than fetched: the marine catalogue at three scales, byte-for-byte as published, sha256-pinned, as plain GeoJSON today and a Signal K resource provider next",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./manifest.json": "./manifest.json",
    "./charts.json": "./charts.json",
    "./data/*": "./data/*.geojson",
    "./styles/*": "./styles/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "sync:refresh": "node scripts/sync.mjs --refresh",
    "prepack": "node scripts/sync.mjs",
    "build:sheet": "node scripts/render-sheet.mjs",
    "build:readme": "node scripts/catalogue-table.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.88"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "coastline",
    "land",
    "map",
    "geojson",
    "natural-earth",
    "marine",
    "signalk"
  ],
  "license": "MIT",
  "author": "Mark Brannan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/coastlines.git"
  },
  "files": [
    "lib",
    "data",
    "styles",
    "manifest.json",
    "charts.json",
    "LICENSE"
  ]
}
