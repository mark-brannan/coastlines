{
  "name": "coastlines",
  "version": "0.0.8-alpha.0",
  "description": "Natural Earth geography on a boat, installed rather than fetched: the marine catalogue at three scales, byte-for-byte as published, sha256-pinned, as plain GeoJSON today and a Signal K resource provider next",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./manifest.json": "./manifest.json",
    "./charts.json": "./charts.json",
    "./catalogue": "./lib/bands.js",
    "./catalogue.json": "./catalogue.json",
    "./provider": "./lib/provider.js",
    "./data/*": "./data/*.geojson",
    "./data/*.shp": "./data/*.shp",
    "./data/*.txt": "./data/*.txt",
    "./styles/*": "./styles/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "sync": "node --max-old-space-size=6144 scripts/sync.mjs",
    "sync:check": "node --max-old-space-size=6144 scripts/sync.mjs --check",
    "sync:refresh": "node --max-old-space-size=6144 scripts/sync.mjs --refresh",
    "prepack": "node scripts/sync.mjs --check --no-cells",
    "build:sheet": "node scripts/render-sheet.mjs",
    "build:readme": "node scripts/catalogue-table.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "coastline",
    "land",
    "map",
    "geojson",
    "natural-earth",
    "marine",
    "signalk"
  ],
  "license": "MIT AND LGPL-3.0-or-later",
  "author": "Mark Brannan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/coastlines.git"
  },
  "files": [
    "lib",
    "data",
    "styles",
    "manifest.json",
    "charts.json",
    "catalogue.json",
    "LICENSE"
  ]
}
